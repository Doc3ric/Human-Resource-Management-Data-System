{
  "name": "csc-plantilla-client",
  "version": "1.0.0",
  "description": "HDMS- Human Resource Data Management System Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "HDMS- Human Resource Data Management System",
  "license": "ISC",
  "build": {
    "appId": "com.cscplantilla.client",
    "productName": "HDMS- Human Resource Data Management System",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}
