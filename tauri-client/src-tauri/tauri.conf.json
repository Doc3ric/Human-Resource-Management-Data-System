{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDMS- Human Resource Data Management System",
  "version": "1.0.0",
  "identifier": "com.phrmo.csc-plantilla",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "label": "main",
        "title": "HDMS- Human Resource Data Management System — PHRMO Portal",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false,
        "zoomHotkeysEnabled": true
      },
      {
        "label": "splashscreen",
        "title": "",
        "url": "splash.html",
        "width": 520,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PHRMO",
    "copyright": "© 2026 PHRMO. All rights reserved.",
    "longDescription": "HDMS- Human Resource Data Management System — PHRMO Desktop Client"
  }
}
